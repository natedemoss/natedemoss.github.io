---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Nathan DeMoss">
  <main>
    <p class="intro">Interesting Stuff!!!</p>
    <ul class="post-list">
      {posts.map((p) => (
        <li class={p.data.thumbnail ? 'has-thumb' : ''}>
          <a href={`/posts/${p.slug}/`}>
            {p.data.thumbnail && <img class="thumb" src={p.data.thumbnail} alt="" />}
            <div class="post-text">
              <div class="title">{p.data.title}</div>
              {p.data.description && <div class="desc">{p.data.description}</div>}
              <div class="date">{p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>
